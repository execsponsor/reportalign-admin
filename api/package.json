{
  "name": "execsponsor-admin-api",
  "version": "1.0.0",
  "description": "ExecSponsor Super Admin Portal - Azure Functions API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');const p=require('path');const s=p.join(__dirname,'src','config');const d=p.join(__dirname,'dist','config');if(fs.existsSync(s)){fs.mkdirSync(d,{recursive:true});fs.readdirSync(s).forEach(f=>fs.copyFileSync(p.join(s,f),p.join(d,f)))}\"",
    "watch": "tsc -w",
    "start": "func start",
    "prestart": "npm run build",
    "lint": "eslint src --ext .ts",
    "test": "jest"
  },
  "dependencies": {
    "@azure/functions": "^4.5.0",
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.2.2",
    "pg": "^8.11.3",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.4.0"
  }
}
